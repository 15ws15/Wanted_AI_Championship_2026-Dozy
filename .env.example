# Server-only Gemini key. Never use a NEXT_PUBLIC_ prefix for this value.
GEMINI_API_KEY="replace-with-google-ai-studio-key"

# ZeroGPU backup for task-breakdown endpoints.
ZERO_GPU_SPACE_URL="https://your-space.hf.space"
ZERO_GPU_TIMEOUT_MS="10000"

# Firebase Web configuration is public client configuration, not a server secret.
# Enable Anonymous Authentication and deploy firestore.rules before using these.
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
